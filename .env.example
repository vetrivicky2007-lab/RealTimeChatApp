# =============================================================
# UniHive Environment Configuration Template (.env.example)
# =============================================================
# Copy this file to .env and set your own values:
# cp .env.example .env
# =============================================================

# MongoDB Atlas Connection URI (Accepts either MONGODB_URI or SPRING_DATA_MONGODB_URI)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/unihive?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/unihive?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/unihive?retryWrites=true&w=majority

# JWT Secret Key (HMAC-SHA256, at least 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_12345

# Allowed Frontend URL for CORS (comma-separated or *)
# When deployed as single service, same-origin requests work automatically.
FRONTEND_URL=*

# Application Port (Render sets this dynamically via $PORT)
PORT=8080
